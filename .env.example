# Copy to .env to override the docker compose defaults.
# Host port the db service is published on (5433 avoids clashing with a local PostgreSQL).
DB_PORT=5433
# Connection string used by the api and migrate services, and by `prisma` on the host.
DATABASE_URL=postgresql://ftt:ftt@localhost:5433/ftt
# Port the api listens on inside its container.
PORT=3000
