generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// One source repository whose test results are tracked (SRS §7).
model Project {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @unique
  uploadTokenHash String   @unique @map("upload_token_hash")
  tokenRotatedAt  DateTime @map("token_rotated_at") @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  reports Report[]
  tests   Test[]

  @@map("project")
}

/// One JUnit XML submission for a single Commit, kept unchanged as received (SRS §7).
model Report {
  id          String @id @default(uuid()) @db.Uuid
  projectId   String @map("project_id") @db.Uuid
  commitSha   String @map("commit_sha")
  contentHash String @map("content_hash")
  sizeBytes   Int    @map("size_bytes")

  branch       String?
  ciRunId      String? @map("ci_run_id")
  ciRunAttempt Int?    @map("ci_run_attempt")
  ciJob        String? @map("ci_job")

  /// pending | processing | processed | failed (SRS §8).
  processingState    String  @default("pending") @map("processing_state")
  processingAttempts Int     @default(0) @map("processing_attempts")
  error              String?
  /// Colliding identities and fixing options (FR-17); set by ticket 03.
  collisionWarning   Json?   @map("collision_warning")

  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)

  /// Queue claim and back-off columns (design §6, ADR-0011); used starting with ticket 03.
  claimedAt     DateTime? @map("claimed_at") @db.Timestamptz(3)
  nextAttemptAt DateTime? @map("next_attempt_at") @db.Timestamptz(3)

  project  Project        @relation(fields: [projectId], references: [id])
  content  ReportContent?
  outcomes Outcome[]

  @@unique([projectId, commitSha, contentHash])
  @@index([processingState, nextAttemptAt, receivedAt])
  @@index([projectId, receivedAt(sort: Desc)])
  @@map("report")
}

/// The Report's raw, unchanged body, kept out of list queries (ADR-0012).
model ReportContent {
  reportId String @id @map("report_id") @db.Uuid
  body     Bytes

  report Report @relation(fields: [reportId], references: [id])

  @@map("report_content")
}

/// A single test case within a Project, identified by `classname` + `name` exactly as
/// reported (FR-14, ADR-0005). A renamed test is a new Test.
model Test {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  classname   String
  name        String
  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(3)

  project  Project   @relation(fields: [projectId], references: [id])
  outcomes Outcome[]

  @@unique([projectId, classname, name])
  @@map("test")
}

/// The result a Test had in one Report: passed, failed or skipped (FR-15, FR-16).
/// `projectId` and `receivedAt` are copied from the Report (design §6) so Flake aggregation
/// (ticket 04) doesn't need a join.
model Outcome {
  id             String   @id @default(uuid()) @db.Uuid
  reportId       String   @map("report_id") @db.Uuid
  testId         String   @map("test_id") @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  commitSha      String   @map("commit_sha")
  /// passed | failed | skipped (FR-15).
  result         String
  /// At most 8 KB, only set when failed (FR-16).
  failureMessage String?  @map("failure_message")
  receivedAt     DateTime @map("received_at") @db.Timestamptz(3)

  report Report @relation(fields: [reportId], references: [id])
  test   Test   @relation(fields: [testId], references: [id])

  @@unique([reportId, testId])
  @@index([projectId, testId, commitSha])
  @@map("outcome")
}
