generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// One source repository whose test results are tracked (SRS §7).
model Project {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @unique
  uploadTokenHash String   @unique @map("upload_token_hash")
  tokenRotatedAt  DateTime @map("token_rotated_at") @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("project")
}
