{
  "name": "@ftt/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "prisma:generate": "prisma generate",
    "typecheck": "prisma generate && tsc --noEmit",
    "test:unit": "vitest run --project unit --coverage",
    "test:integration": "prisma generate && vitest run --project integration"
  },
  "dependencies": {
    "@ftt/contracts": "*",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@prisma/adapter-pg": "~7.10.0",
    "@prisma/client": "~7.10.0",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.2",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "~7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.3",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "5.0.4",
    "pg": "^8.23.1",
    "supertest": "^7.3.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "5.0.4"
  }
}
